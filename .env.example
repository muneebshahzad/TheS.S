# Daraz Open Platform seller integration
DARAZ_API_URL=https://api.daraz.pk/rest
DARAZ_APP_KEY=
DARAZ_APP_SECRET=

# Optional bootstrap values. OAuth tokens are persisted in the application database.
DARAZ_ACCESS_TOKEN=
DARAZ_REFRESH_TOKEN=
DARAZ_TOKEN_EXPIRES_AT=

# Optional order-feed controls
DARAZ_ORDER_STATUSES=shipped,pending,ready_to_ship,packed
DARAZ_ORDER_LOOKBACK_DAYS=365
DARAZ_PAGE_LIMIT=50
DARAZ_MAX_PAGES_PER_STATUS=1

# DigiDokaan courier tracking (same integration used by the Al Karamat portal)
DIGIDOKAAN_API_URL=https://digidokaan.pk
DIGIDOKAAN_PHONE=
DIGIDOKAAN_PASSWORD=
DIGIDOKAAN_GATEWAY_ID=5

# Order analytics. Enable only after both migrations have been applied.
ORDER_ANALYTICS_ENABLED=false
ANALYTICS_TIMEZONE=Asia/Karachi
ANALYTICS_CURRENCY=PKR
# Reuse Railway's existing DATABASE_URL, APP_SECRET_KEY, ADMIN_PORTAL_PASSWORD,
# SHOPIFY_WEBHOOK_SECRET and Shopify/courier configuration. Never use defaults in production.

# GA4 web stream (the property ID is NOT the measurement ID)
GA4_PROPERTY_ID=491963638
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Mounted service account JSON file, with Viewer access to the GA4 property.
GOOGLE_APPLICATION_CREDENTIALS=
# Railway alternative: full service-account JSON in a secret variable (no file needed).
# Takes precedence for both Google Ads and GA4 reporting. Never commit the value.
GOOGLE_REPORTING_SERVICE_ACCOUNT_JSON=

# Google Ads reporting account explicitly requested. Linked account 7576092690
# is a different account and must be verified before substituting it.
GOOGLE_ADS_CUSTOMER_ID=3776479482
# Enable Google Ads API and obtain production access for the credentials' Cloud project.
# Developer tokens were sunset September 9, 2026; do not configure one.
# Prefer a dedicated service account with Google Ads Read-only access:
GOOGLE_ADS_JSON_KEY_FILE_PATH=
# Alternatively use OAuth client credentials (leave these unset for service-account auth):
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Optional manager account, without dashes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_USE_PROTO_PLUS=true

# Meta reporting only: ads_read, business asset assignment to this ad account.
META_AD_ACCOUNT_ID=356232020087034
META_BUSINESS_ID=838669770883289
META_ACCESS_TOKEN=
# Current tested Graph/Marketing API release. Review before each Meta upgrade.
META_API_VERSION=v26.0
