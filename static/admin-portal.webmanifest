  "description": "The Sleek Space mobile operations dashboard for orders, tracking, payments and fulfilment.",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/static/employee-portal-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
