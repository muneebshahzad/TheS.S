{
  "name": "Sleek Space Admin Portal",
  "short_name": "Sleek Admin",
  "id": "/admin_portal",
  "start_url": "/admin_portal",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f4efe6",
